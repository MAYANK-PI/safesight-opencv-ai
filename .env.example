# AWS Configuration
# Copy this file to .env and fill in your actual values.
# Do NOT commit your actual .env file to version control.
#
# Credentials should preferably come from an appropriately authorized IAM role
# or IAM Identity Center/SSO. The application uses boto3's standard credential
# provider chain, which checks (in order):
#   1. Environment variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN)
#   2. Shared credentials file (~/.aws/credentials)
#   3. Shared config file (~/.aws/config)
#   4. EC2/ECS instance profile credentials
#   5. IAM Identity Center / AWS CLI SSO credentials
# Do not put actual credentials in this file or commit them to version control.

AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=            # Optional: only if not using IAM role/SSO
# AWS_SECRET_ACCESS_KEY=        # Optional: only if not using IAM role/SSO
# AWS_SESSION_TOKEN=            # Optional: for temporary credentials
# AWS_PROFILE=                  # Optional: for named profiles in ~/.aws/credentials
# AWS_DEFAULT_REGION=           # Fallback region if AWS_REGION not set

# S3 bucket for evidence storage (required for S3 uploads)
# The bucket must exist and the identity must have s3:PutObject, s3:GetObject permissions
AWS_S3_BUCKET=

# CloudWatch log group for structured logs and metrics
# The application will not create this automatically; create it manually or via IaC
AWS_CLOUDWATCH_LOG_GROUP=/aws/industrial-safety-inspector

# Vision API Configuration (Optional - for multimodal analysis)
# Set VISION_PROVIDER=openai and add your OPENAI_API_KEY to enable
VISION_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key-here
VISION_MODEL=gpt-4o-mini
VISION_MAX_CALLS_PER_VIDEO=10
VISION_TIMEOUT_SECONDS=30
VISION_ENABLED=true